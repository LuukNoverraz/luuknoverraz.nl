---
import '../styles/global.css';
import {
  base,
  copy,
  langNames,
  langs,
  mainLangs,
  moreLangs,
  projectCopy,
  social,
  year,
  type Lang,
  type ProjectSlug,
} from '../content';
import Logo from '../components/Logo.astro';

interface Props {
  lang: Lang;
  /** Set on project pages. */
  project?: ProjectSlug;
  /** Set on the 404 page: no canonical, no alternates, not indexed. */
  notFound?: boolean;
  /** Set on other pages, such as the archive: their address and heading. */
  subpage?: { slug: string; title: string; description: string };
}

const { lang, project, notFound, subpage } = Astro.props;
const t = copy[lang];
const site = Astro.site!;

const slug = project ?? subpage?.slug;
const pathFor = (l: Lang) => base(l) + (slug ? `${slug}/` : '');
const alternates = Object.fromEntries(langs.map((l) => [l, new URL(pathFor(l), site).href])) as Record<Lang, string>;
const current = (l: Lang) => (!notFound && lang === l ? 'page' : undefined);
const canonical = alternates[lang];
const pp = project ? projectCopy(lang, project).p : undefined;
const title = pp ? `${pp.name} – ${t.meta.title}` : subpage ? `${subpage.title} – ${t.meta.title}` : t.meta.title;
const description = pp ? pp.paragraphs[0].replace(/<[^>]+>/g, '') : (subpage?.description ?? t.meta.description);


const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Luuk Noverraz',
  url: site.href,
  jobTitle: ['Philosophy student', 'Game Developer', 'Web Developer'],
  address: { '@type': 'PostalAddress', addressLocality: 'Amsterdam', addressCountry: 'NL' },
  sameAs: [social.linkedin, social.github, social.itch],
};
---

<!doctype html>
<html lang={t.htmlLang} id="top">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {
      notFound ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {langs.map((l) => <link rel="alternate" hreflang={copy[l].htmlLang} href={alternates[l]} />)}
          <link rel="alternate" hreflang="x-default" href={alternates.nl} />
        </>
      )
    }


    <link rel="preload" href="/fonts/ShipporiMincho-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/NeueHaasDisplayRoman.woff2" as="font" type="font/woff2" crossorigin />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL('/og.jpg', site).href} />
    <meta property="og:locale" content={t.meta.locale} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="icon" href="/favicon/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/favicon/apple-touch-icon.png" />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <link rel="mask-icon" href="/favicon/safari-pinned-tab.svg" color="#ce2a29" />
    <meta name="msapplication-TileColor" content="#ce2a29" />
    <meta name="msapplication-config" content="/favicon/browserconfig.xml" />
    <meta name="theme-color" content="#efede8" />

    {!notFound && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>

  <body>
    <a class="skip-link" href="#main">{t.nav.skip}</a>

    <header class="topbar">
      <a class="logo" href={base(lang)} aria-label="Luuk Noverraz – home">
        <Logo />
      </a>
      <div class="lang-switch">
        <p>
          {
            mainLangs.map((l, i) => (
              <>
                {i > 0 && ' / '}
                <a href={pathFor(l)} hreflang={l} lang={l} aria-current={current(l)}>
                  {l.toUpperCase()}
                </a>
              </>
            ))
          }
        </p>
        <span aria-hidden="true">/</span>
        {/* The other languages are AI-translated; they live behind the globe. */}
        <details class="lang-more">
          <summary aria-label={t.nav.moreLanguages} title={t.nav.moreLanguages}>
            <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="9"></circle>
              <ellipse cx="12" cy="12" rx="3.8" ry="9"></ellipse>
              <path d="M3 12h18M4.6 7.2h14.8M4.6 16.8h14.8"></path>
            </svg>
          </summary>
          <ul>
            {
              moreLangs.map((l) => (
                <li>
                  <a href={pathFor(l)} hreflang={copy[l].htmlLang} lang={copy[l].htmlLang} aria-current={current(l)}>
                    {langNames[l]}
                  </a>
                </li>
              ))
            }
          </ul>
        </details>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        {/* Easter egg: the first year opens the earlier versions of this site. */}
        <a class="since" href={`${base(lang)}archive/`} aria-label={`2016: ${t.archive.link}`} title={t.archive.link}>2016</a>–{year} © Luuk Noverraz
        {t.translationNote && <span class="translation-note">{t.translationNote}</span>}
      </p>
      <a href={social.source} target="_blank" rel="noopener" aria-label={t.footer.source}>
        <img src="/icons/code.svg" alt="" width="27" height="27" />
      </a>
    </footer>

    <script>
      // Language: someone arriving at the bare address (the Dutch home page) is sent
      // to the version matching their browser's language, once. After that their own
      // choice in the language switch wins and is remembered. Only the home page does
      // this, so links to a specific page always open that page. Search engines and
      // test tools are left alone so every language stays reachable for them.
      (() => {
        const KEY = 'lang';
        const store = {
          get: () => {
            try {
              return localStorage.getItem(KEY);
            } catch {
              return null;
            }
          },
          set: (v: string) => {
            try {
              localStorage.setItem(KEY, v);
            } catch {
              /* private mode: just don't remember */
            }
          },
        };

        // The page lists its own translations in <link rel="alternate">; read them from there.
        const homes = new Map<string, string>();
        for (const link of document.querySelectorAll<HTMLLinkElement>('link[rel="alternate"][hreflang]')) {
          const code = link.hreflang.toLowerCase().split('-')[0];
          if (code !== 'x') homes.set(code, new URL(link.href).pathname);
        }

        // Remember a choice made by hand in the switch.
        for (const a of document.querySelectorAll<HTMLAnchorElement>('.lang-switch a[hreflang]')) {
          a.addEventListener('click', () => store.set(a.hreflang.toLowerCase().split('-')[0]));
        }

        if (location.pathname !== '/' || !homes.size) return;
        // Coming back from another page on this site (e.g. a project's Back link): stay.
        if (document.referrer && new URL(document.referrer).origin === location.origin) return;
        if (/bot|crawl|spider|slurp|lighthouse|headless/i.test(navigator.userAgent)) return;

        let want = store.get();
        if (!want) {
          const prefs = navigator.languages?.length ? navigator.languages : [navigator.language];
          want = prefs.map((p) => p.toLowerCase().split('-')[0]).find((c) => homes.has(c)) ?? 'en';
          store.set(want);
        }
        const target = homes.get(want);
        if (target && target !== '/') location.replace(target + location.hash);
      })();

      // Fold-outs (language menu, earlier games): browsers keep their contents alive
      // while closed, so CSS animations would only play the first time. Re-adding the
      // class on every opening restarts them.
      for (const d of document.querySelectorAll<HTMLDetailsElement>('details.lang-more, details.earlier')) {
        d.addEventListener('toggle', () => {
          d.classList.remove('opening');
          if (!d.open) return;
          void d.offsetWidth; // let the removal take effect first
          d.classList.add('opening');
        });
      }

      // Top bar: mark it hidden while scrolling down and shown while scrolling up.
      // The stylesheet only acts on this on screens where the bar covers content.
      const topbar = document.querySelector<HTMLElement>('.topbar');
      let lastY = scrollY;
      addEventListener(
        'scroll',
        () => {
          const y = Math.max(scrollY, 0);
          if (Math.abs(y - lastY) < 8) return; // ignore jitter
          topbar?.toggleAttribute('data-hidden', y > lastY && y > 80);
          lastY = y;
        },
        { passive: true },
      );

      // Project loops: only download and play while on screen, never with reduced motion,
      // and not before the page has finished loading (keeps them off the critical path).
      const videos = document.querySelectorAll<HTMLVideoElement>('video[data-loop]');
      const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)');
      let started = false;
      const startVideos = () => {
        if (started || reduceMotion.matches) return;
        started = true;
        const io = new IntersectionObserver((entries) => {
          for (const { target, isIntersecting } of entries) {
            const video = target as HTMLVideoElement;
            if (isIntersecting) {
              video.preload = 'auto';
              video.play().catch(() => {});
            } else {
              video.pause();
            }
          }
        });
        videos.forEach((v) => io.observe(v));
      };
      if (videos.length) {
        if (document.readyState === 'complete') startVideos();
        else addEventListener('load', startVideos, { once: true });
      }
      reduceMotion.addEventListener('change', () => {
        if (reduceMotion.matches) videos.forEach((v) => v.pause());
        else if (started) videos.forEach((v) => v.play().catch(() => {}));
        else startVideos();
      });
    </script>
  </body>
</html>
