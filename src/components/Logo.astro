---
// The signature mark in the top bar. One centre line, drawn the way a flat pen held
// at an angle would draw it: the line is repeated along the nib, so strokes across
// the nib come out thick and strokes along it thin. Inline SVG, so nothing loads.
const line =
  'M24 64C38 52 54 34 55 23C55 15 46 17 40 27C31 43 23 62 22 73C22 79 32 74 47 60C44 67 41 77 44 79C48 81 62 62 80 49';

const nib = { dx: 0.52, dy: -0.47, steps: 7 }; // half the nib, in steps either side of centre
const offsets = Array.from({ length: nib.steps * 2 + 1 }, (_, i) => i - nib.steps).filter((i) => i !== 0);
const round = (n: number) => Math.round(n * 100) / 100;
---

<svg
  viewBox="14 10 74 78"
  width="74"
  height="78"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  <path id="logo-line" d={line}></path>
  {offsets.map((i) => <use href="#logo-line" x={round(i * nib.dx)} y={round(i * nib.dy)} />)}
</svg>
