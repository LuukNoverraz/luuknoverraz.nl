---
// Earlier versions of this site, reached through "2016" in the footer.
import { existsSync } from 'node:fs';
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Base from '../layouts/Base.astro';
import { base, copy, type Lang } from '../content';
import shot2026 from '../assets/archive/2026.jpg';
import shot2023 from '../assets/archive/2023.jpg';
import shot2022 from '../assets/archive/2022.jpg';
import shot2021 from '../assets/archive/2021.jpg';
import shot2020 from '../assets/archive/2020.jpg';
import shot2019 from '../assets/archive/2019.jpg';
import shot2018 from '../assets/archive/2018.jpg';
import shot2017 from '../assets/archive/2017.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = copy[lang];
const repo = 'https://github.com/LuukNoverraz/luuknoverraz.nl';

// Newest first. `visit` is where the version can be opened: older versions are
// published from git history by scripts/archive-versions.mjs at build time.
// `code` is left out for the 2017-2021 versions: their repositories are private.
const all: { year: string; shot: ImageMetadata; code?: string; visit?: string }[] = [
  { year: '2026', shot: shot2026, code: repo },
  { year: '2023', shot: shot2023, code: `${repo}/tree/ab8ad59`, visit: '/museum/2023/' },
  { year: '2022', shot: shot2022, code: `${repo}/tree/251d614`, visit: '/museum/2022/' },
  { year: '2021', shot: shot2021, visit: '/museum/2021/' },
  { year: '2020', shot: shot2020, visit: '/museum/2020/' },
  { year: '2019', shot: shot2019, visit: '/museum/2019/' },
  { year: '2018', shot: shot2018, visit: '/museum/2018/' },
  { year: '2017', shot: shot2017, visit: '/museum/2017/' },
];
// Only offer "visit" for versions the archive step actually published: a build
// without access to a private repository simply leaves that link out.
const editions = all.map((e) => ({
  ...e,
  visit: e.visit && existsSync(`public${e.visit}index.html`) ? e.visit : undefined,
}));
---

<Base lang={lang} subpage={{ slug: 'museum', title: t.archive.title, description: t.archive.intro }}>
  <article class="section archive">
    <a class="back" href={base(lang)}>
      <span aria-hidden="true">←</span> {t.back}
    </a>
    <h1 class="section-title">{t.archive.title}</h1>
    <p class="archive-intro">{t.archive.intro}</p>
    <ol class="editions">
      {
        editions.map((e) => (
          <li class="edition">
            {e.visit ? (
              <a class="edition-shot" href={e.visit} tabindex="-1" aria-hidden="true">
                <Picture
                  src={e.shot}
                  formats={['avif', 'webp']}
                  widths={[480, 960, 1440]}
                  sizes="(max-width: 768px) 100vw, 36rem"
                  alt=""
                  loading="lazy"
                />
              </a>
            ) : (
              <div class="edition-shot">
                <Picture
                  src={e.shot}
                  formats={['avif', 'webp']}
                  widths={[480, 960, 1440]}
                  sizes="(max-width: 768px) 100vw, 36rem"
                  alt=""
                  loading="lazy"
                />
              </div>
            )}
            <div class="edition-text">
              <h2>{e.year}</h2>
              <p>{t.archive.editions[e.year]}</p>
              <p class="edition-links">
                {e.visit && <a href={e.visit}>{t.archive.visit}</a>}
                {e.code && (
                  <a href={e.code} target="_blank" rel="noopener">
                    {t.archive.code}
                  </a>
                )}
              </p>
            </div>
          </li>
        ))
      }
    </ol>
  </article>
</Base>
